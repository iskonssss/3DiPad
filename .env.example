# Copy to .env . Never commit the real .env.

# Port the booth server listens on
PORT=3000

# --- Google Drive (optional; integrations.drive.enabled=true to use) ---
# Path to a Google service-account JSON key with access to the target Drive folder.
GOOGLE_APPLICATION_CREDENTIALS=./secrets/drive-service-account.json

# --- WhatsApp Business Cloud API (optional; integrations.whatsapp.enabled=true) ---
# From Meta: the phone-number ID and a permanent access token, plus your approved template name (set in config.json).
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
