# Copy to .env . Never commit the real .env.

# Port the booth server listens on
PORT=3000

# --- Google Drive (optional; integrations.drive.enabled=true to use) ---
# Path to a Google service-account JSON key with access to the target Drive folder.
GOOGLE_APPLICATION_CREDENTIALS=./secrets/drive-service-account.json

# --- GoHighLevel (notify.provider=ghl) ---
# Inbound Webhook URLs from your GHL workflow triggers. One is enough (branch on
# payload.event); set a second if you want lead-capture and pickup on separate flows.
GHL_LEAD_WEBHOOK_URL=
GHL_READY_WEBHOOK_URL=

# --- WhatsApp Business Cloud API (only if notify.provider=meta) ---
# From Meta: the phone-number ID and a permanent access token, plus your approved template name (set in config.json).
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=

# --- Operator panel on the kiosk (send-to-printer from the iPad) ---
# 4 digits. Empty or unset = no PIN, and the hold on the corner button is the
# only thing in the way. Also settable as operator.pin in config.json; this wins.
BOOTH_ADMIN_PIN=
